# ═══════════════════════════════════════════════════════════════
# WageNow Ghana — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── Database ──
# Local dev (docker compose up):
DATABASE_URL=postgresql://wagenow:wagenow_dev@localhost:5432/wagenow
# Production (Supabase): copy from Dashboard → Settings → Database → Connection string
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
JWT_SECRET=                          # Min 32 chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY=                      # Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Hubtel MoMo ──
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_BASE_URL=https://devp-hubtel-payment-proxy-api.hubtel.com
MOMO_WEBHOOK_SECRET=
MOMO_CALLBACK_URL=https://your-api-domain.com/webhooks/momo/callback

# ── Twilio ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Supabase ──
# All from: Dashboard → Settings → API
SUPABASE_SERVICE_KEY=                # service_role key (never expose to client)
SUPABASE_JWT_SECRET=                 # JWT Secret (for verifying Supabase-issued tokens)
NEXT_PUBLIC_SUPABASE_URL=            # Project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # anon/public key

# ── App ──
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
