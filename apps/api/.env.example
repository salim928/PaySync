# ── Database ──
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0

# ── Auth ──
# Generate: openssl rand -hex 32
JWT_SECRET=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Hubtel MoMo ──
HUBTEL_CLIENT_ID=placeholder
HUBTEL_CLIENT_SECRET=placeholder
MOMO_WEBHOOK_SECRET=placeholder

# ── Twilio (SMS OTP) ──
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=placeholder

# ── Supabase ──
SUPABASE_SERVICE_KEY=
# Get from: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App ──
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
